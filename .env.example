# Скопируйте в .env и задайте свои значения
SECSCAN_USER=admin
SECSCAN_PASS=смените-пароль
# ---- виды проверок (по умолчанию; переключаются и на веб-морде) ----
# 0 — отключить OWASP ZAP (не тянуть большой образ при разработке)
SECSCAN_ZAP_ENABLED=1
# nuclei — сигнатурный веб-сканер (шаблоны скачаются при первом запуске)
SECSCAN_NUCLEI_ENABLED=1
# nmap UDP (top-50 портов) — медленнее TCP-скана
SECSCAN_UDP_ENABLED=0
# доп. NSE-скрипты nmap: ssl-enum-ciphers, http-methods, http-trace
SECSCAN_NSE_ENABLED=1
# NSE vulners для nmap (сверка CVE)
SECSCAN_NMAP_VULNERS=1
# TLS/SSL-анализ https-целей (testssl.sh)
SECSCAN_SSL_ENABLED=1
# ---- образы сканеров ----
# SECSCAN_NMAP_IMAGE=instrumentisto/nmap:latest
# SECSCAN_ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
# SECSCAN_NUCLEI_IMAGE=projectdiscovery/nuclei:v2.9.14   # v2: совместим со старыми CPU (v3 падает SIGILL)
# SECSCAN_SSL_IMAGE=drwetter/testssl.sh:latest
# ---- прочее ----
# Сеть контейнеров-сканеров: на Linux — host; на Docker Desktop задайте пустое
# значение (SECSCAN_DOCKER_NETWORK=) — будет bridge-сеть
SECSCAN_DOCKER_NETWORK=host
# Локальный часовой пояс — времена задач (список, отчёты, PDF)
SECSCAN_TZ=Asia/Yekaterinburg
# Поиск соседних сайтов на IP цели (TLS-сертификаты + crt.sh); 0 — отключить
SECSCAN_CRTSH=1
