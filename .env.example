# Скопируйте в .env и задайте свои значения
SECSCAN_USER=admin
SECSCAN_PASS=смените-пароль
# Все виды проверок (nmap TCP+UDP с NSE, ZAP, TLS/SSL, nuclei) выполняются
# всегда — переключателей нет.
# 0 — не искать соседние сайты на IP цели (TLS-сертификаты + crt.sh/certspotter)
SECSCAN_CRTSH=1
# Локальный часовой пояс для времён задач
SECSCAN_TZ=Asia/Yekaterinburg
# Как запускаются движки-сканеры:
#   docker — разовыми контейнерами через docker.sock (Linux-сервер, значение
#            по умолчанию; так работает docker-compose.yml);
#   local  — процессами внутри этого же контейнера (образ «всё в одном»,
#            Dockerfile.allinone/docker-compose.allinone.yml; нужен для
#            macOS/Windows Docker Desktop, где docker.sock и --network host
#            недоступны).
# SECSCAN_ENGINE_MODE=local
# Пути к движкам для режима local (по умолчанию — из PATH образа)
# SECSCAN_NMAP_BIN=nmap
# SECSCAN_ZAP_BIN=zap-baseline.py
# SECSCAN_NUCLEI_BIN=nuclei
# SECSCAN_SSL_BIN=testssl.sh
# Каталог, из которого zap-baseline.py запускается в режиме local: скрипт
# пишет отчёт только в смонтированный каталог, поэтому в образе allinone
# /zap/wrk объявлен как VOLUME (по умолчанию он же и используется)
# SECSCAN_ZAP_WORKDIR=/zap/wrk
# Образы сканеров (переопределение при необходимости; в режиме local не
# используются)
# SECSCAN_NMAP_IMAGE=instrumentisto/nmap:latest
# SECSCAN_ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
# SECSCAN_NUCLEI_IMAGE=projectdiscovery/nuclei:v2.9.14
# SECSCAN_SSL_IMAGE=drwetter/testssl.sh:latest
# Docker Desktop (Windows): пустое значение отключает --network host
# SECSCAN_DOCKER_NETWORK=
