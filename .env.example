# Скопируйте в .env и задайте свои значения
SECSCAN_USER=admin
SECSCAN_PASS=смените-пароль
# 0 — отключить OWASP ZAP (не тянуть большой образ при разработке)
SECSCAN_ZAP_ENABLED=1
# NSE vulners для nmap (сверка CVE)
SECSCAN_NMAP_VULNERS=1
# Сеть контейнеров-сканеров (nmap/ZAP): на Linux — host; на Docker Desktop
# задайте пустое значение (SECSCAN_DOCKER_NETWORK=) — будет bridge-сеть
SECSCAN_DOCKER_NETWORK=host
# ---- OpenVAS (Greenbone) — тот же docker-compose, профиль greenbone ----
# Включайте только на машине, где запущен стек Greenbone: secscan общается
# с gvmd по GMP через общий unix-сокет /run/gvmd/gvmd.sock.
SECSCAN_OPENVAS_ENABLED=0
SECSCAN_GMP_USER=admin
# Пароль администратора gvmd (задаётся один раз при первом старте стека:
#   docker compose exec -u gvmd gvmd gvmd --user=admin --new-password='...'
# и должен совпадать с SECSCAN_GMP_PASS здесь)
SECSCAN_GMP_PASS=
# Локальный часовой пояс — времена задач (список, отчёты, PDF)
SECSCAN_TZ=Asia/Yekaterinburg
# Поиск соседних сайтов на IP цели (TLS-сертификаты + crt.sh); 0 — отключить
SECSCAN_CRTSH=1
