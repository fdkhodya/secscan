# Скопируйте в .env и задайте свои значения
SECSCAN_USER=admin
SECSCAN_PASS=смените-пароль
# Все виды проверок (nmap TCP+UDP с NSE, ZAP, TLS/SSL, nuclei) выполняются
# всегда — переключателей нет.
# 0 — не искать соседние сайты на IP цели (TLS-сертификаты + crt.sh/certspotter)
SECSCAN_CRTSH=1
# Локальный часовой пояс для времён задач
SECSCAN_TZ=Asia/Yekaterinburg
# Образы сканеров (переопределение при необходимости)
# SECSCAN_NMAP_IMAGE=instrumentisto/nmap:latest
# SECSCAN_ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
# SECSCAN_NUCLEI_IMAGE=projectdiscovery/nuclei:v2.9.14
# SECSCAN_SSL_IMAGE=drwetter/testssl.sh:latest
# Docker Desktop (Windows): пустое значение отключает --network host
# SECSCAN_DOCKER_NETWORK=
